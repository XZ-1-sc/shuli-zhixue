# Optional override for Docker only.
# In most cases you do not need this because Docker mode automatically rewrites
# localhost / 127.0.0.1 in DATABASE_URL to host.docker.internal.
#
# Keep DATABASE_URL in backend/.env for normal local Python startup.
#
# PowerShell example:
# $env:DOCKER_DATABASE_URL="mysql+pymysql://root:%40your_password@host.docker.internal:3306/math_brain"
#
# If your MySQL password contains @, write it as %40 in the URL.
DOCKER_DATABASE_URL=mysql+pymysql://root:%40your_password@host.docker.internal:3306/math_brain
TEACHER_INVITE_CODE=
UPLOAD_DIR=/workspace/uploads
MAX_ANSWER_IMAGE_BYTES=8388608
STORAGE_BACKEND=local
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=300
DB_SSL_CA_CERT=
