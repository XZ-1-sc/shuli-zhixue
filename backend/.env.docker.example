# Optional override for Docker only.
# In most cases you do not need this because Docker mode automatically rewrites
# localhost / 127.0.0.1 in DATABASE_URL to host.docker.internal.
#
# Keep DATABASE_URL in backend/.env for normal local Python startup.
#
# PowerShell example:
# $env:DOCKER_DATABASE_URL="mysql+pymysql://root:%40your_password@host.docker.internal:3306/xingce"
#
# If your MySQL password contains @, write it as %40 in the URL.
DOCKER_DATABASE_URL=mysql+pymysql://root:%40your_password@host.docker.internal:3306/xingce
