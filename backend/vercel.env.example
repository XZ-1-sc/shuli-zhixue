SUPABASE_BUCKET=math-brain-uploads
RUN_DB_MIGRATIONS=0
DB_POOL_SIZE=1
DB_MAX_OVERFLOW=1
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=300
STATIC_DIR=
